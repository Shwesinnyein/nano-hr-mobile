# Display original attendance_model.dart and then write a refactored version to /mnt/data/attendance_model.refactored.dart
from pathlib import Path
orig_path = Path("/mnt/data/attendance_model.dart")
orig = orig_path.read_text(encoding="utf-8")
print("---- ORIGINAL attendance_model.dart ----\n")
print(orig)
print("\n---- END ORIGINAL ----\n\nNow writing refactored file...")

refactored = r'''// attendance_model.dart
// Refactored model with robust JSON parsing and helpful factory methods.
// Handles String/int mismatches and nullable fields gracefully.

class Attendance {
  final String id;
  final String employeeId;
  final DateTime timestamp;
  final String type; // 'check-in' or 'check-out' or other
  final String? note;
  final double? latitude;
  final double? longitude;
  final String? source; // optional: web/mobile/other

  Attendance({
    required this.id,
    required this.employeeId,
    required this.timestamp,
    required this.type,
    this.note,
    this.latitude,
    this.longitude,
    this.source,
  });

  // Safe helper to parse int or string id to string
  static String _parseId(dynamic value) {
    if (value == null) return '';
    return value.toString();
  }

  // Safe helper to parse timestamp from various formats
  static DateTime _parseTimestamp(dynamic value) {
    if (value == null) return DateTime.fromMillisecondsSinceEpoch(0);
    if (value is int) {
      // assume epoch seconds or millis? we try to detect
      if (value > 9999999999) {
        // milliseconds
        return DateTime.fromMillisecondsSinceEpoch(value);
      } else {
        // seconds
        return DateTime.fromMillisecondsSinceEpoch(value * 1000);
      }
    }
    if (value is String) {
      // try ISO first
      try {
        return DateTime.parse(value);
      } catch (_) {
        // maybe numeric string
        final n = int.tryParse(value);
        if (n != null) {
          if (n > 9999999999) {
            return DateTime.fromMillisecondsSinceEpoch(n);
          } else {
            return DateTime.fromMillisecondsSinceEpoch(n * 1000);
          }
        }
      }
    }
    // fallback
    return DateTime.fromMillisecondsSinceEpoch(0);
  }

  static double? _parseDouble(dynamic v) {
    if (v == null) return null;
    if (v is double) return v;
    if (v is int) return v.toDouble();
    if (v is String) return double.tryParse(v);
    return null;
  }

  factory Attendance.fromJson(Map<String, dynamic> json) {
    return Attendance(
      id: _parseId(json['id'] ?? json['_id'] ?? json['attendanceId'] ?? json['uuid']),
      employeeId: json['employeeId']?.toString() ?? json['empId']?.toString() ?? '',
      timestamp: _parseTimestamp(json['timestamp'] ?? json['time'] ?? json['createdAt'] ?? json['date']),
      type: json['type']?.toString() ?? json['status']?.toString() ?? '',
      note: json['note']?.toString(),
      latitude: _parseDouble(json['latitude'] ?? json['lat']),
      longitude: _parseDouble(json['longitude'] ?? json['lng'] ?? json['long']),
      source: json['source']?.toString(),
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'id': id,
      'employeeId': employeeId,
      'timestamp': timestamp.toIso8601String(),
      'type': type,
      if (note != null) 'note': note,
      if (latitude != null) 'latitude': latitude,
      if (longitude != null) 'longitude': longitude,
      if (source != null) 'source': source,
    };
  }
}
'''

out_path = Path("/mnt/data/attendance_model.refactored.dart")
out_path.write_text(refactored, encoding="utf-8")
print("Refactored file written to:", out_path)
